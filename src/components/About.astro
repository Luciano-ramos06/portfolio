---
import { Icon } from 'astro-icon/components'
---

<section id="home" class="px-6 pt-24 pb-32 md:h-screen">
            <div class="max-w-5xl mx-auto">
                <div class="flex flex-col md:flex-row items-center gap-10">
                    <div class="flex-shrink-0">
                        <img src="https://avatars.githubusercontent.com/u/166407494?v=4" alt="Mi foto" class="w-48 h-48 md:w-56 md:h-56 rounded-full object-cover shadow-lg"/>
                    </div>

                    <div class="text-center md:text-left">
                        <h1 class="text-4xl md:text-5xl font-bold text-neutral-200">Luciano Ramos Cavero</h1>

                        <p class="mt-4 text-2xl text-neutral-300 max-w-md"> Tecnico Universitario en Programacion.</p>

                        <div class="mt-4 text-xl flex flex-col md:flex-row gap-4 text-neutral-300 items-center md:items-start justify-center md:justify-start">
                            <div class="flex gap-4">
                                <a href="https://github.com/Luciano-ramos06" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition">
                                    <Icon name="mdi:github" class="text-2xl" />
                                </a>
                                <a href="mailto:1lucho2cavero3@email.com" class="hover:text-amber-400 transition">
                                    <Icon name="mdi:gmail" class="text-2xl" />
                                </a>
                            </div>
                            
                            <a class="flex items-center gap-1 text-sm hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:location-on-outline" class="text-lg"/>
                                Argentina, Bahía Blanca.
                            </a>
                        </div>
                    
                    </div>
                </div>

                <div class="flex flex-col gap-16 mt-24">
                    <div class="flex flex-col gap-3">
                        <h2 class="text-3xl font-bold text-neutral-200"> About Me </h2>

                        <p class="md:col-span-2 text-lg text-neutral-300 leading-relaxed">
                            Web developer from Argentina and Tecnicatura Universitaria en Programacion student at UTN.
                            I have experience developing both frontend and backend applications. I'm now looking to further my career 
                            and expand my technical expertise within a professional dev team.
                        </p>
                    </div>
                    
                    <div class="flex flex-col gap-3">
                        <h2 class="text-3xl font-bold text-neutral-200">Skills</h2>
                        <div class="text-lg text-neutral-300 flex md:flex-row gap-5 flex-wrap items-center">
                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:language-typescript"/>
                                Typescript
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:language-javascript"/>
                                JavaScript
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:language-php"/>
                                PHP
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:language-python"/>
                                C++
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:language-python"/>
                                Python
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:react"/>
                                React
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:language-css3"/>
                                CSS
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:tailwind"/>
                                Tailwind CSS
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:docker"/>
                                Docker
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:sql-query"/>
                                SQL
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:sql-query"/>
                                MongoDB
                            </a>

                            <a class="flex flex-col items-center hover:text-amber-400 transition cursor-default">
                                <Icon name="mdi:nodejs"/>
                                Node.js
                            </a>

                        </div>
                    </div>
                </div>
                
            </div>
</section>