---
import BackendSuplementos from "@/assets/BackendSuplementos.webp";
import FrontendSuplementos from "@/assets/FrontendSuplementos.webp";
import TuProfeEnQr from "@/assets/TuProfeEnQr.webp";
import { Icon } from 'astro-icon/components';
import {Image} from 'astro:assets';
import { TimePrecision } from "astro:schema";
---
<section id="projects" class="py-24 px-6 z-0 relative">
      <div class="flex flex-col max-w-6xl mx-auto">

        <h2 class="text-3xl font-bold text-neutral-200 mb-12">Projects</h2>

        <div class="grid md:grid-cols-2 gap-4">
          <div class="flex flex-col gap-4 border-solid border-2 border-neutral-300 rounded-lg p-2">
            <h2 class="text-xl font-bold text-neutral-200">Suplementos Deportivos Api</h2>
            <div class="h-64 overflow-hidden rounded-lg">
              <Image src={BackendSuplementos} alt="Proyecto 1" class="w-full h-full object-cover shadow-md"/>
            </div>
            <p class="mt-2 text-neutral-300">Backend de eCommerce desarrollado en equipo como parte del proyecto final integrador de la carrera universitaria, con enfoque en escalabilidad y buenas prácticas. El sistema gestiona usuarios, productos, categorías, carrito, órdenes y reseñas mediante una API REST.</p>
            <div class="text-neutral-300 flex items-center gap-2 mt-auto">
              <a href="https://github.com/FrancoPanzone/Backend-BD-TP-Integrador" target="_blank" rel="noopener noreferrer">
                <Icon name="mdi:github" class="text-2xl hover:text-amber-400 transition"/>
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  Typescript
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  PostgreSQL
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  Docker
              </a>
            </div>
          </div>

          <div class="flex flex-col gap-4 border-solid border-2 border-neutral-300 rounded-lg p-2">
            <h2 class="text-xl font-bold text-neutral-200">Suplementos Deportivos Web</h2>
            <div class="h-64 overflow-hidden rounded-lg">
              <Image src={FrontendSuplementos} alt="Proyecto 2" class="w-full h-full object-cover shadow-md"/>
            </div>
            <p class="mt-2 text-neutral-300">Frontend de eCommerce desarrollado en equipo como parte del proyecto final integrador de la carrera universitaria, con enfoque en escalabilidad y buenas prácticas. El sistema permite a los usuarios navegar por productos, agregarlos al carrito y realizar compras.</p>
            <div class="text-neutral-300 flex items-center gap-2 mt-auto">
              <a href="https://github.com/FrancoPanzone/Backend-BD-TP-Integrador" target="_blank" rel="noopener noreferrer">
                <Icon name="mdi:github" class="text-2xl hover:text-amber-400 transition"/>
              </a>

              <a href="https://frontend-suplementos-one.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-xs text-center hover:text-amber-400 transition border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  Ver Pagina
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  Typescript
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  Tailwind
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  React
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  Docker
              </a>
            </div>
          </div>

          <div class="flex flex-col gap-4 border-solid border-2 border-neutral-300 rounded-lg p-2">
            <h2 class="text-xl font-bold text-neutral-200">Tu Profe En QR</h2>
            <div class="h-64 overflow-hidden rounded-lg">
              <Image src={TuProfeEnQr} alt="Proyecto 2" class="w-full h-full object-cover shadow-md"/>
            </div>
            <p class="mt-2 text-neutral-300">Sitio web desarrollado con PHP que lista los ejercicios disponibles en las pistas de salud de Bahía Blanca. La página permite a los usuarios visualizar los ejercicios y sus características.</p>
            <div class="text-neutral-300 flex items-center gap-2 mt-auto">
              <a href="https://github.com/FrancoPanzone/Backend-BD-TP-Integrador" target="_blank" rel="noopener noreferrer">
                <Icon name="mdi:github" class="text-2xl hover:text-amber-400 transition"/>
              </a>

              <a href="https://tuprofeenqr.page.gd/public/home" target="_blank" rel="noopener noreferrer" class="text-xs text-center hover:text-amber-400 transition border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  Ver Pagina
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  PHP
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  CSS
              </a>

              <a class="text-xs text-center hover:text-amber-400 transition cursor-default border-solid border-1 border-neutral-300 px-2 py-1 rounded-lg">
                  SQL
              </a>
              
            </div>
          </div>

        </div>
      </div>
</section>